# Secrets locaux (Vercel injecte ses propres variables chiffrées).
.env
.env.*

# Dumps complets de données utilisateur : indispensables en local, jamais à uploader au build.
data/backups/
data/jeera_backup.json
data/recent_sessions.json

# Outils DB opérationnels/destructifs, inutiles au runtime Vercel. Tout le dossier est exclu, sauf
# `scripts/generate-sw.ts` dont package.json::prebuild dépend : lister les scripts un par un laissait
# passer chaque nouveau script, qui cassait le build en important `_safety.ts` (exclu, lui).
scripts/*
!scripts/generate-sw.ts
scripts/_safety.ts
scripts/backfill-*.ts
scripts/export-backup.ts
scripts/fix-catalog-profile-*.ts
scripts/fix-intra-workout-*.ts
scripts/fix-muscle-mappings-*.ts
scripts/import-*.ts
scripts/recover-*.ts
scripts/apply-known-muscle-profiles.ts
scripts/migrate-prod-*.ts
scripts/seed.ts
scripts/seed-catalog-*.ts
